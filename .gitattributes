# Normalize line endings: LF in the repo and in the working tree.
* text=auto eol=lf

# Windows batch files must stay CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files: never touch them.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ttf binary
*.otf binary
*.zip binary
