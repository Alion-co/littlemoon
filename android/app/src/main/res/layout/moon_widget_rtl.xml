<?xml version="1.0" encoding="utf-8"?>
<!-- [RTL] ویجت مربع (۲×۲): کارت هیرو با رنگ تم. شب: متن‌ها داخل حلقه (روز، فاز با نقطه‌ی رنگی، وضعیت).
     روز: ماه، «روز | فاز»، نوار فازها و وضعیت. MoonWidgetRenderer یکی از این دو بخش رو نشون می‌ده.
     حاشیه‌ها و اندازه‌ی متن‌ها این‌جا فقط پیش‌فرض‌اند؛ MoonWidgetRenderer.fitToSize با اندازه‌ی واقعی ویجت عوضشون می‌کنه. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl">

    <!-- پس‌زمینه‌ی کارت (گرادیان، گوشه‌ی گرد و لبه) از کد و با رنگ تم کشیده می‌شه -->
    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY" />

    <!-- ستاره‌های ریز فقط در ظاهر شب -->
    <ImageView
        android:id="@+id/widget_stars"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/widget_stars" />

    <FrameLayout
        android:id="@+id/widget_night_body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="9dp">

        <ImageView
            android:id="@+id/widget_ring"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:id="@+id/widget_night_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <TextView
                android:id="@+id/widget_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="17sp" />

            <LinearLayout
                android:id="@+id/widget_phase_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_phase_dot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="5dp"
                    android:contentDescription="@null"
                    android:src="@drawable/widget_phase_dot" />

                <TextView
                    android:id="@+id/widget_phase"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="#FFFFFF"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:lineSpacingMultiplier="1.1"
                android:maxLines="2"
                android:textColor="#C7FFFFFF"
                android:textSize="9sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- ظاهر روز (تم روشن) -->
    <LinearLayout
        android:id="@+id/widget_day_body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="11dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/widget_moon"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:contentDescription="@null"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/widget_day_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autoSizeMaxTextSize="14sp"
            android:autoSizeMinTextSize="8sp"
            android:autoSizeTextType="uniform"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/widget_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/widget_day_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textSize="9sp" />
    </LinearLayout>
</FrameLayout>
